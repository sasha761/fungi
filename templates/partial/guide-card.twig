<article class="c-guide-card">
	{% if guide_item.thumbnail %}
		<a class="c-guide-card__image" href="{{ guide_item.permalink|e('html_attr') }}">
			<picture>
				{% if guide_item.thumbnail.webp %}
					<source srcset="{{ guide_item.thumbnail.webp|e('html_attr') }}" type="image/webp">
				{% endif %}
				<img
					src="{{ guide_item.thumbnail.url|e('html_attr') }}"
					alt="{{ guide_item.title|e('html_attr') }}"
					width="{{ guide_item.thumbnail.width|e('html_attr') }}"
					height="{{ guide_item.thumbnail.height|e('html_attr') }}"
					loading="lazy"
				>
			</picture>
		</a>
	{% endif %}

	{% if heading_level == 2 %}
		<h2 class="c-guide-card__title">
			<a href="{{ guide_item.permalink|e('html_attr') }}">{{ guide_item.title|e }}</a>
		</h2>
	{% else %}
		<h3 class="c-guide-card__title">
			<a href="{{ guide_item.permalink|e('html_attr') }}">{{ guide_item.title|e }}</a>
		</h3>
	{% endif %}

	{% if guide_item.excerpt %}
		<p class="c-guide-card__excerpt">{{ guide_item.excerpt|e }}</p>
	{% endif %}
</article>
