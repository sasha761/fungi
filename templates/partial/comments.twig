<section class="l-comments">
  <div class="c-comments comment-respond" id="respond" aria-labelledby="comments-title">
    {% set isReviewForm = stars | default(false) %}
    {% set formTitle = isReviewForm
      ? 'Write a review' | translateString('Comments - Write a review')
      : 'Write a comment' | translateString('Comments - Write a comment')
    %}
    {% set listTitle = isReviewForm
      ? 'Reviews' | translateString('Product - Reviews')
      : 'Comments' | translateString('Comments - Comments')
    %}
    {% set commentsCount = total_comments | default(0) %}

    <div class="c-comments__header">
      <h3 class="u-h3 c-comments__heading" id="comments-title">{{ listTitle }} ({{ commentsCount }})</h3>
    </div>

    <form class="c-comment-form js-comment-form" id="commentform" method="post" action="{{ site.site_url }}/wp-comments-post.php" aria-label="{{ formTitle }}">
      {% if not user %}
        <p class="c-comment-form__notice">{{ 'Your email will not be published. * Marker for mandatory fields' | translateString('Comments - Notification') }}</p>

        <div class="c-comments__registration">
          <div class="c-comments__grid">
            <div class="c-comments__field">
              <div class="c-input js-input-block">
                <label for="comment_email">{{ 'Email' | translateString('Input - Email') }}*</label>
                <input required name="email" type="email" id="comment_email">
              </div>
            </div>

            <div class="c-comments__field">
              <div class="c-input js-input-block">
                <label for="comment_name">{{ 'Name' | translateString('Comments - Name') }}*</label>
                <input required name="author" type="text" id="comment_name">
              </div>
            </div>

            {% if isReviewForm %}
              <div class="c-comments__field c-comments__field--rating">
                <div class="c-comments__registration-label">
                  {{ 'Evaluation' | translateString('Comments - Evaluation') }}*
                  <div class="comment-form-rating">
                    <select name="rating" id="rating" required>
                      <option value="">{{ 'Rate...' | translateString('Comments - Rate') }}</option>
                      <option value="5">{{ 'Excellent' | translateString('Comments - Excellent') }}</option>
                      <option value="4">{{ 'Good' | translateString('Comments - Good') }}</option>
                      <option value="3">{{ 'Average' | translateString('Comments - Average') }}</option>
                      <option value="2">{{ 'Not bad' | translateString('Comments - Not bad') }}</option>
                      <option value="1">{{ 'Very poor' | translateString('Comments - Very poor') }}</option>
                    </select>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if user and isReviewForm %}
        <div class="c-comments__registration">
          <div class="c-comments__registration-label">
            {{ 'Evaluation' | translateString('Comments - Evaluation') }}*
            <div class="comment-form-rating">
              <select name="rating" id="rating" required>
                <option value="">{{ 'Rate...' | translateString('Comments - Rate') }}</option>
                <option value="5">{{ 'Excellent' | translateString('Comments - Excellent') }}</option>
                <option value="4">{{ 'Good' | translateString('Comments - Good') }}</option>
                <option value="3">{{ 'Average' | translateString('Comments - Average') }}</option>
                <option value="2">{{ 'Not bad' | translateString('Comments - Not bad') }}</option>
                <option value="1">{{ 'Very poor' | translateString('Comments - Very poor') }}</option>
              </select>
            </div>
          </div>
        </div>
      {% endif %}

      {% if user %}
        <input type="hidden" name="email" value="{{ user.email }}">
        <input type="hidden" name="author" value="{{ user.name }}">
        <input type="hidden" name="url" value="{{ user.link }}">
      {% endif %}

      <input type="hidden" name="comment_post_ID" value="{{ post_id }}">
      <input type="hidden" name="comment_parent" id="comment_parent" value="0">

      <div class="c-comment-form__body">
        <div class="c-input c-input--textarea c-comment-form__textarea js-input-block">
          <label for="comment">{{ 'Your comment' | translateString('input - Your comment') }}*</label>
          <textarea name="comment" id="comment" rows="6" placeholder="{{ 'Write a comment...' | translateString('Comments - Write a comment placeholder') }}" required></textarea>
        </div>

        <button class="u-btn is-black c-comment-form__submit" type="submit" name="comment_submit">
          {{ 'Post comment' | translateString('Comments - Post comment') }}
        </button>
      </div>
    </form>

    {% if comments %}
      <div class="c-comments__box">
        {% for comment in comments %}
          {% include 'comment.twig' with { comment: comment, depth: 0 } %}
        {% endfor %}
      </div>
    {% else %}
      <p class="c-comments__empty">{{ 'No comments yet.' | translateString('Comments - No comments yet') }}</p>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.reply-link').forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();

      var commentId = this.getAttribute('data-comment-id');
      var commentParent = document.getElementById('comment_parent');
      var commentForm = document.getElementById('commentform');

      if (!commentParent || !commentForm) {
        return;
      }

      commentParent.value = commentId;

      var header = document.querySelector('.l-header');
      var yOffset = (header ? header.offsetHeight : 0) + 15;
      var y = commentForm.getBoundingClientRect().top + window.pageYOffset - yOffset;

      window.scrollTo({ top: y, behavior: 'smooth' });

      var commentInput = commentForm.querySelector('textarea[name="comment"], input[name="comment"]');

      if (commentInput) {
        commentInput.focus();
      }
    });
  });

  document.querySelectorAll('.like-btn, .dislike-btn').forEach(function(button) {
    button.addEventListener('click', function(e) {
      e.preventDefault();

      var commentId = this.getAttribute('data-comment-id');
      var actionType = this.getAttribute('data-action');
      var btn = this;
      var data = new FormData();

      data.append('action', 'comment_reaction');
      data.append('comment_id', commentId);
      data.append('action_type', actionType);

      fetch("{{ ajax_url }}", {
        method: 'POST',
        body: data
      })
        .then(response => response.json())
        .then(result => {
          if (result.success) {
            if (actionType === 'like') {
              btn.querySelector('.like-count').textContent = result.data.count;
            } else {
              btn.querySelector('.dislike-count').textContent = result.data.count;
            }
          }
        })
        .catch(error => console.error('Comment reaction request failed:', error));
    });
  });
});
</script>
