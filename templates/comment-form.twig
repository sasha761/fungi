<form class="c-comment-form" id="commentform" method="post" action="{{ site.site_url }}/wp-comments-post.php">
  {% if user == false %}
    <h3 class="u-h3">{{ 'Write a review' | translateString('Comments - Write a review') }}</h3>
    <p>{{ 'Your email will not be published. * Marker for mandatory fields' | translateString('Comments - Notification') }}</p>
    <div class="c-comments__registration">
      
      <div class="c-input js-input-block">
        <label for="comment_email">{{ 'Email' | translateString('Input - Email') }}* </label>
        <input required name="email" type="email" id="comment_email">
      </div>

      <div class="c-input js-input-block">
        <label for="comment_name">{{ 'Name' | translateString('Comments - Name') }}* </label>
        <input required name="author" type="text" id="comment_name">
      </div>

      {% if stars %}
        <div class="c-comments__registration-label">{{ 'Evaluation' | translateString('Comments - Evaluation') }}* <br>
          <div class="comment-form-rating">
            <select name="rating" id="rating" required>
              <option value="">{{ 'Rate...' | translateString('Comments - Rate') }}</option>
              <option value="5">{{ 'Excellent' | translateString('Comments - Excellent') }}</option>
              <option value="4">{{ 'Good' | translateString('Comments - Good') }}</option>
              <option value="3">{{ 'Average' | translateString('Comments - Average') }}</option>
              <option value="2">{{ 'Not bad' | translateString('Comments - Not bad') }}</option>
              <option value="1">{{ 'Very poor' | translateString('Comments - Very poor') }}</option>
            </select>
          </div>
        </div> 
      {% endif %} 
    </div>
  {% endif %}
  {% if user and stars %}
    <div class="c-comments__registration">
      <div class="c-comments__registration-label">{{ 'Evaluation' | translateString('Comments - Evaluation') }}* <br>
        <div class="comment-form-rating">
          <select name="rating" id="rating" required>
            <option value="">{{ 'Rate...' | translateString('Comments - Rate') }}</option>
            <option value="5">{{ 'Excellent' | translateString('Comments - Excellent') }}</option>
            <option value="4">{{ 'Good' | translateString('Comments - Good') }}</option>
            <option value="3">{{ 'Average' | translateString('Comments - Average') }}</option>
            <option value="2">{{ 'Not bad' | translateString('Comments - Not bad') }}</option>
            <option value="1">{{ 'Very poor' | translateString('Comments - Very poor') }}</option>
          </select>
        </div>
      </div>
    </div>
  {% endif %}
  
  <div class="c-comments__submit c-subscribe">
    <div class="c-input js-input-block">
      {% if user %}
        <input type="hidden" name="email" value="{{ user.email }}">
        <input type="hidden" name="author" value="{{ user.name }}">
        <input type="hidden" name="url" value="{{ user.link }}">
      {% endif %}

      <input name="comment_post_ID" value="{{ post_id }}" type="hidden">
      <input name="comment_parent"  value="{{ comment.ID|default('0') }}" type="hidden">
      <input type="text" name="comment" required  placeholder="{{ 'Your comment' | translateString('input - Your comment') }}">
      <button class="u-btn is-black" type="submit" name="Submit">{{ 'Send' | translateString('buttons - Send') }}</button>
    </div>
  </div>
</form>


