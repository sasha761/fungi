{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "acf/pillar-posts-grid",
  "version": "1.0.0",
  "title": "Pillar Posts Grid",
  "description": "A manually ordered grid of related posts and pages.",
  "category": "fungi-category",
  "icon": "screenoptions",
  "keywords": [
    "pillar",
    "posts",
    "grid"
  ],
  "textdomain": "news",
  "supports": {
    "align": false,
    "anchor": true,
    "html": false,
    "jsx": false
  },
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "acf": {
    "mode": "preview",
    "renderTemplate": "render.php"
  }
}
